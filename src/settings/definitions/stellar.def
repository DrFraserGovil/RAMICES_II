SETTING(std::string,IsochroneDirectory,"Resources/Isochrones","iso-dir","The relative path to the directory in which the raw isochrone files are located.\nThis option is unused if both a lifetime archive and an observable archive is specified.")
SETTING(std::string,LifetimeFile,"__none__","lifetime","If not the file exists and ForceIsochroneRecopute is false, used as an isochrone lifetime input file. Expects a .iso file.\nIf an isochrone recompute is called, the lifetime archive is instead saved at this location")
SETTING(bool,ForceIsochroneRecompute,false,"isochrone-recompute","If true, forces a recompute of the lifetimes ")
SETTING(std::string,IsochroneScript,"NEEDS_DEFAULT","isochrone-script","The location of the isochrone-processing script used to generate lifetime and observables data.\n\tThe script is only run if ForceIsochroneRecompute is true, or if the LifetimeFile does not exist.")
SETTING(double,MaxStellarMass,100,"max-star-mass","The maximum mass of a star it is possible to make (solar units)")
SETTING(double,MinStellarMass,0.1,"min-star-mass","The minimum mass of a star it is possible to make (solar units)")
SETTING(double,MaxLogZ,-0.1,"max-star-logz","The maximum metallicity possible in stars and gas")
SETTING(double,MinLogZ,-6,"min-star-logz","The metallicity below which a star/gas is considered 'pristine'")
SETTING(int,MetallicityResolution,100,"logz-resolution","The number of interpolation points between MinLogZ and MaxLogZ used for stellar properties")